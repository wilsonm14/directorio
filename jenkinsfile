pipeline {
    agent any

    stages {
        stage('1. Checkout') {
            steps {
                // Taller 1: Trae el código de GitHub
                checkout scm
            }
        }

        stage('2. Build & Test (CI)') {
            steps {
                echo 'Cumpliendo Taller 1: Probando app.js'
                // Ejecuta tu script de prueba
                sh 'node app.js'
            }
        }

        stage('3. Pull de Imágenes (CD)') {
            steps {
                echo 'Cumpliendo Taller 2: Bajando imágenes de Docker Hub'
                // Esto asegura que usemos lo que está en la nube
                sh 'docker compose pull'
            }
        }

        stage('4. Deploy') {
            steps {
                echo 'Desplegando microservicios...'
                // Levanta todo el ecosistema (Gateway, Users, etc.)
                sh 'docker compose up -d'
            }
        }
    }
    
    post {
        success {
            echo '¡Felicidades Wilson! El pipeline terminó con éxito.'
        }
    }
}